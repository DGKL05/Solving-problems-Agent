.login-section {
  display: flex;
  justify-content: center;
  padding: 40px;
}

.login-btn {
  background: #4A90D9;
  color: white;
  border-radius: 24px;
  padding: 12px 32px;
}

.profile-section {
  text-align: center;
  padding: 24px;
}

.avatar {
  width: 80px;
  height: 80px;
  border-radius: 40px;
  margin: 0 auto 12px;
  overflow: hidden;
}

.avatar image {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  font-size: 40px;
  line-height: 80px;
}

.nickname {
  font-size: 18px;
  font-weight: bold;
}

.stats {
  display: flex;
  justify-content: space-around;
  margin-top: 24px;
}

.stat-item {
  display: flex;
  flex-direction: column;
}

.stat-num {
  font-size: 24px;
  font-weight: bold;
  color: #4A90D9;
}

.stat-label {
  font-size: 12px;
  color: #999;
  margin-top: 4px;
}

.settings {
  margin-top: 24px;
  background: white;
  border-radius: 12px;
}

.setting-item {
  display: flex;
  justify-content: space-between;
  padding: 16px;
  border-bottom: 1px solid #f0f0f0;
}
