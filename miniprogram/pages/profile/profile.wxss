.login-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60px 40px 40px;
}

.login-hint {
  font-size: 14px;
  color: #999;
  margin-bottom: 20px;
}

.login-btn {
  background: #07c160;
  color: white;
  border-radius: 24px;
  padding: 14px 48px;
  font-size: 16px;
  border: none;
}

.profile-section {
  text-align: center;
  padding: 32px 24px 24px;
  background: linear-gradient(135deg, #4A90D9, #357ABD);
  margin-bottom: 16px;
  border-radius: 0 0 24px 24px;
}

.avatar-btn {
  width: 72px;
  height: 72px;
  border-radius: 36px;
  margin: 0 auto 12px;
  padding: 0;
  overflow: hidden;
  background: rgba(255,255,255,0.3);
  border: 3px solid rgba(255,255,255,0.6);
  display: block;
  line-height: 1;
}

.avatar-btn::after {
  border: none;
}

.avatar-btn image {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  font-size: 28px;
  line-height: 66px;
  color: white;
  font-weight: bold;
}

.nickname-wrap {
  margin: 8px 0;
}

.nickname-text {
  font-size: 18px;
  font-weight: bold;
  color: white;
}

.nickname-input {
  text-align: center;
  font-size: 18px;
  font-weight: bold;
  color: white;
  background: transparent;
  border: none;
  min-height: 32px;
}

.nickname {
  display: block;
  font-size: 20px;
  font-weight: bold;
  color: white;
  margin-bottom: 4px;
}

.uid {
  display: block;
  font-size: 12px;
  color: rgba(255,255,255,0.7);
  margin-bottom: 4px;
}

.login-status {
  display: inline-block;
  font-size: 12px;
  background: rgba(255,255,255,0.2);
  color: white;
  padding: 2px 12px;
  border-radius: 10px;
  margin-top: 4px;
}

.stats {
  display: flex;
  justify-content: space-around;
  margin-top: 24px;
  padding: 16px 0;
  background: rgba(255,255,255,0.15);
  border-radius: 12px;
}

.stat-item {
  display: flex;
  flex-direction: column;
}

.stat-num {
  font-size: 24px;
  font-weight: bold;
  color: white;
}

.stat-label {
  font-size: 12px;
  color: rgba(255,255,255,0.8);
  margin-top: 4px;
}

.settings {
  margin: 16px;
  background: white;
  border-radius: 12px;
}

.setting-item {
  display: flex;
  justify-content: space-between;
  padding: 16px;
  border-bottom: 1px solid #f0f0f0;
}

.arrow {
  color: #ccc;
}
