<view class="container">
  <view wx:if="{{!userInfo}}" class="login-section">
    <button bindtap="onLogin" class="login-btn">微信一键登录</button>
  </view>

  <view wx:else class="profile-section">
    <view class="avatar">
      <image wx:if="{{userInfo.avatarUrl}}" src="{{userInfo.avatarUrl}}" mode="aspectFill"/>
      <view wx:else class="avatar-placeholder">👤</view>
    </view>
    <text class="nickname">{{userInfo.nickname}}</text>

    <view class="stats">
      <view class="stat-item">
        <text class="stat-num">{{stats.totalSolved}}</text>
        <text class="stat-label">已解决</text>
      </view>
      <view class="stat-item">
        <text class="stat-num">{{stats.mistakes}}</text>
        <text class="stat-label">错题</text>
      </view>
      <view class="stat-item">
        <text class="stat-num">{{stats.sessions}}</text>
        <text class="stat-label">会话</text>
      </view>
    </view>
  </view>

  <view class="settings">
    <view class="setting-item" bindtap="onClearCache">
      <text>清除缓存</text>
      <text>→</text>
    </view>
  </view>
</view>
