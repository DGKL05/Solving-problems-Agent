<view class="container">
  <scroll-view class="message-list" scroll-y scroll-into-view="msg-{{messages.length - 1}}">
    <view wx:for="{{messages}}" wx:key="index" id="msg-{{index}}" class="message {{item.role}}">
      <view class="bubble">
        <text wx:if="{{item.isImage}}">[📷 图片]</text>
        <text wx:else>{{item.content}}</text>
      </view>
      <view class="time">{{item.time}}</view>
    </view>
  </scroll-view>

  <view class="input-bar">
    <button class="image-btn" bindtap="chooseImage">📷</button>
    <input class="text-input" value="{{inputText}}" bindinput="onInput" placeholder="输入消息..." confirm-type="send" bindconfirm="sendMessage"/>
    <button class="send-btn" bindtap="sendMessage">发送</button>
  </view>
</view>

<view wx:if="{{showSubjectPicker}}" class="picker-overlay">
  <view class="picker-modal">
    <text class="picker-title">选择题型</text>
    <button class="subject-btn" data-type="ACM" bindtap="onSubjectSelect">💻 ACM 算法</button>
    <button class="subject-btn" data-type="MATH" bindtap="onSubjectSelect">📐 高等数学</button>
    <button class="subject-btn" data-type="CS408" bindtap="onSubjectSelect">📚 考研408</button>
    <button class="cancel-btn" bindtap="onSubjectSelect" data-type="">取消</button>
  </view>
</view>
