.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.message-list {
  flex: 1;
  padding: 16px;
}

.message {
  margin-bottom: 16px;
}

.message .bubble {
  padding: 12px 16px;
  border-radius: 12px;
  max-width: 80%;
  word-break: break-all;
}

.message.user .bubble {
  background-color: #4A90D9;
  color: white;
  align-self: flex-end;
  margin-left: auto;
}

.message.assistant .bubble {
  background-color: white;
  color: #333;
}

.message .time {
  font-size: 12px;
  color: #999;
  margin-top: 4px;
}

.input-bar {
  display: flex;
  padding: 12px;
  background: white;
  border-top: 1px solid #eee;
}

.text-input {
  flex: 1;
  border: 1px solid #ddd;
  border-radius: 20px;
  padding: 8px 16px;
  margin: 0 8px;
}

.image-btn, .send-btn {
  padding: 8px 12px;
  background: #4A90D9;
  color: white;
  border-radius: 20px;
  font-size: 14px;
}

.picker-overlay {
  position: fixed;
  top: 0;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}

.picker-modal {
  background: white;
  border-radius: 16px;
  padding: 24px;
  width: 80%;
}

.picker-title {
  font-size: 18px;
  font-weight: bold;
  margin-bottom: 16px;
  text-align: center;
}

.subject-btn {
  margin: 8px 0;
  padding: 12px;
  background: #4A90D9;
  color: white;
  border-radius: 8px;
  font-size: 16px;
}

.cancel-btn {
  margin-top: 12px;
  background: #eee;
  color: #666;
  border-radius: 8px;
}
