<view class="container">
  <view class="tag-bar">
    <text class="tag {{activeTag === null ? 'active' : ''}}" bindtap="onTagFilter" data-tag="">全部</text>
    <text wx:for="{{tags}}" wx:key="index" class="tag {{activeTag === item ? 'active' : ''}}" bindtap="onTagFilter" data-tag="{{item}}">{{item}}</text>
  </view>

  <view wx:if="{{mistakes.length === 0}}" class="empty">暂无错题记录</view>

  <view wx:for="{{mistakes}}" wx:key="id" class="mistake-card" bindtap="viewDetail" data-id="{{item.id}}">
    <view class="card-header">
      <text class="subject">{{item.subjectType}}</text>
      <text class="date">{{item.createdAt}}</text>
    </view>
    <text class="preview">{{item.cleanedText}}</text>
    <view class="card-footer">
      <text class="error-type">🔴 {{item.errorType}}</text>
      <view class="card-tags">
        <text wx:for="{{item.tags}}" wx:key="index" wx:for-item="tag" class="mini-tag">{{tag}}</text>
      </view>
    </view>
  </view>
</view>
